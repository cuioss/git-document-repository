<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.cuioss</groupId>
        <artifactId>cui-java-parent</artifactId>
        <version>1.7.7</version>
        <relativePath/>
    </parent>
    <artifactId>git-document-repository</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <!-- Must be declared: <inceptionYear> is inherited, and the license plugin binds the
         copyright ${year} to it. Without this, a new project reports cui-parent-pom's 2022
         and every -Ppre-commit run restamps every header. customize.sh sets this. -->
    <inceptionYear>2026</inceptionYear>
    <name>git document repository</name>
    <description>Base libraries for "Git as the Persistence of Versioned Documents"
    </description>
    <url>https://github.com/cuioss/git-document-repository/</url>
    <scm>
        <url>https://github.com/cuioss/git-document-repository/</url>
        <connection>
            scm:git:https://github.com/cuioss/git-document-repository.git
        </connection>
        <developerConnection>
            scm:git:https://github.com/cuioss/git-document-repository/
        </developerConnection>
        <tag>HEAD</tag>
    </scm>
    <issueManagement>
        <url>https://github.com/cuioss/git-document-repository/issues</url>
        <system>GitHub Issues</system>
    </issueManagement>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- JGit 7.8.0: the Maven version string of the tag v7.8.0.202609011348-r, as served by Maven Central. -->
            <dependency>
                <groupId>org.eclipse.jgit</groupId>
                <artifactId>org.eclipse.jgit</artifactId>
                <version>7.8.1.202611041320-r</version>
            </dependency>
            <!-- JOL 0.17: the latest release in maven-metadata.xml of org.openjdk.jol:jol-core on Maven Central,
                 checked 2026-11-21; cui-java-parent 1.7.7 does not manage it. Test scope of git-store only
                 (GDR-NFR-1, IndexFootprintTest). -->
            <dependency>
                <groupId>org.openjdk.jol</groupId>
                <artifactId>jol-core</artifactId>
                <version>0.17</version>
            </dependency>
            <!-- snakeyaml-engine 3.2, the YAML library of git-forms (owner's approval 2026-11-21), not managed by
                 cui-java-parent 1.7.7; checked: its 3.2 POM declares test-scope dependencies only. -->
            <dependency>
                <groupId>org.snakeyaml</groupId>
                <artifactId>snakeyaml-engine</artifactId>
                <version>3.2</version>
            </dependency>
            <!-- json-schema 1.9.1, the JSON Schema validator of git-forms (owner's approval 2026-11-21), not managed by
                 cui-java-parent 1.7.7; checked: its 1.9.1 POM declares no compile dependency and only optional
                 runtime dependencies, so it adds nothing to the closure of a consumer. -->
            <dependency>
                <groupId>dev.harrel</groupId>
                <artifactId>json-schema</artifactId>
                <version>1.9.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <modules>
        <module>git-core</module>
        <module>git-forms</module>
        <module>git-store</module>
        <module>git-testing</module>
        <module>git-timestamp</module>
    </modules>
    <build>
        <plugins>
            <!-- GDR-GEN-1: the modules depend on one another only along the graph of
                 doc/concepts/module-structure.adoc. This rule bans every direct reactor dependency
                 (de.cuioss:git-*) except git-testing in scope test, which every module may test against.
                 Every module lists its allowed reactor edges in its own POM, one include per edge, appended
                 to this rule with combine.children="append" in an execution of the same id. The inherited
                 mojo-enforcer-rules execution stays untouched. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>module-layering</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <excludes>
                                        <exclude>de.cuioss:git-*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>de.cuioss:git-testing:*:*:test</include>
                                    </includes>
                                    <message>GDR-GEN-1: a module declares a reactor dependency outside the module graph of doc/concepts/module-structure.adoc. Add an allowed edge to the module-layering rule of the module's own POM only when the graph names it.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
